<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_custom_units" model="ir.ui.view">
        <field name="name">product.template.form.custom.units</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field name="uom_mediumm"/>
                <field name="uom_largee"/>
            </field>
            <!-- uom_small added by saycare_medicine_views.xml -->
        </field>
    </record>

    <record id="product_template_form_expiration_date" model="ir.ui.view">
        <field name="name">product.template.form.expiration.date</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="expiration_date" invisible="type == 'service'"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_name_en" model="ir.ui.view">
        <field name="name">product.template.form.name.en</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <field name="name_en" placeholder="e.g. Cheese Burger"/>
            </group>
        </field>
    </record>

    <record id="product_category_form_categ_type" model="ir.ui.view">
        <field name="name">product.category.form.categ.type</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group name="saycare_categ">
                    <field name="name_ar"/>
                    <field name="categ_type"/>
                </group>
            </group>
        </field>
    </record>


<record id="product_category_list_categ_type" model="ir.ui.view">
        <field name="name">product.category.list.categ.type</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="name_ar"/>
                <field name="categ_type"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_form_payment_type" model="ir.ui.view">
        <field name="name">product.pricelist.form.payment.type</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="country_group_ids" position="after">
                <field name="x_payment_type" string="Payment Type"/>
            </field>
        </field>
    </record>

</odoo>