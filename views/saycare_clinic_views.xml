<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════════════════════
       saycare.specialty  (Clinic)
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_saycare_specialty_tree" model="ir.ui.view">
    <field name="name">saycare.specialty.tree</field>
    <field name="model">saycare.specialty</field>
    <field name="arch" type="xml">
      <list string="العيادات">
        <field name="name"/>
        <field name="code"/>
        <field name="room_number"/>
        <field name="categ_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_saycare_specialty_form" model="ir.ui.view">
    <field name="name">saycare.specialty.form</field>
    <field name="model">saycare.specialty</field>
    <field name="arch" type="xml">
      <form string="العيادة">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="اسم العيادة"/></h1>
          </div>

          <group>
            <group string="معلومات أساسية">
              <field name="code"/>
              <field name="room_number"/>
              <field name="active"/>
              <field name="color" widget="color_picker"/>
            </group>
            <group string="الإعدادات">
              <field name="categ_id"
                     domain="[]"
                     options="{'no_create_edit': False}"
                     help="فئة المنتجات الخاصة بهذه العيادة (للمستلزمات والمخزون)"/>
              <field name="description"/>
            </group>
          </group>

          <notebook>
            <page string="الخدمات" name="services">
              <field name="service_ids" context="{'default_specialty_id': id}">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="code"/>
                  <field name="visit_type"/>
                  <field name="price"/>
                  <field name="insurance_price"/>
                  <field name="active"/>
                </list>
              </field>
            </page>

            <page string="الأطباء" name="doctors">
              <field name="doctor_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="job_title"/>
                  <field name="license_number"/>
                  <field name="work_email"/>
                  <field name="work_phone"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_saycare_specialty" model="ir.actions.act_window">
    <field name="name">العيادات</field>
    <field name="res_model">saycare.specialty</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">أنشئ عيادة جديدة</p>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════
       saycare.service  (Service Catalog)
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_saycare_service_tree" model="ir.ui.view">
    <field name="name">saycare.service.tree</field>
    <field name="model">saycare.service</field>
    <field name="arch" type="xml">
      <list string="الخدمات الطبية">
        <field name="specialty_id"/>
        <field name="name"/>
        <field name="code"/>
        <field name="visit_type"/>
        <field name="price"/>
        <field name="insurance_price"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_saycare_service_form" model="ir.ui.view">
    <field name="name">saycare.service.form</field>
    <field name="model">saycare.service</field>
    <field name="arch" type="xml">
      <form string="الخدمة الطبية">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="اسم الخدمة"/></h1>
          </div>
          <group>
            <group string="التصنيف">
              <field name="code"/>
              <field name="specialty_id"/>
              <field name="visit_type"/>
              <field name="active"/>
            </group>
            <group string="التسعير">
              <field name="price"/>
              <field name="insurance_price"/>
            </group>
          </group>
          <group string="ملاحظات">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_saycare_service" model="ir.actions.act_window">
    <field name="name">الخدمات الطبية</field>
    <field name="res_model">saycare.service</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">أضف خدمة طبية جديدة</p>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════
       saycare.visit  (Visit Journal)
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_saycare_visit_list" model="ir.ui.view">
    <field name="name">saycare.visit.list</field>
    <field name="model">saycare.visit</field>
    <field name="arch" type="xml">
      <list string="سجل الزيارات"
            decoration-success="state == 'done'"
            decoration-warning="state == 'in_progress'">
        <field name="name"/>
        <field name="admission_date"/>
        <field name="patient_id"/>
        <field name="specialty_id"/>
        <field name="doctor_id"/>
        <field name="visit_type" optional="show"/>
        <field name="financial_class" optional="show"/>
        <field name="state" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_saycare_visit_form" model="ir.ui.view">
    <field name="name">saycare.visit.form</field>
    <field name="model">saycare.visit</field>
    <field name="arch" type="xml">
      <form string="الزيارة">
        <header>
          <field name="state" widget="statusbar"
                 statusbar_visible="waiting,doctor_queue,in_progress,done"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="بيانات الزيارة">
              <field name="patient_id"/>
              <field name="admission_date"/>
              <field name="discharge_date"/>
              <field name="visit_type"/>
            </group>
            <group string="الوجهة المالية والعيادة">
              <field name="financial_class"/>
              <field name="specialty_id"/>
              <field name="doctor_id"
                     domain="[('medical_role','=','doctor')]"/>
              <field name="nurse_id"
                     domain="[('medical_role','=','nurse')]"/>
            </group>
          </group>
          <group string="الشكوى والملاحظات">
            <field name="chief_complaint" nolabel="1"
                   placeholder="الشكوى الرئيسية…"/>
            <field name="notes" nolabel="1" placeholder="ملاحظات…"/>
          </group>

          <group string="الخدمات والمدفوعات">
            <group>
              <field name="total_price"     string="إجمالي الخدمات"/>
              <field name="insurance_share" string="حصة التأمين"/>
              <field name="patient_share"   string="حصة المريض"/>
            </group>
          </group>

          <notebook>
            <page string="الخدمات المطلوبة" name="services">
              <field name="service_ids" widget="many2many_tags"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_saycare_visit_search" model="ir.ui.view">
    <field name="name">saycare.visit.search</field>
    <field name="model">saycare.visit</field>
    <field name="arch" type="xml">
      <search string="الزيارات">
        <field name="patient_id"/>
        <field name="name"/>
        <field name="specialty_id"/>
        <field name="doctor_id"/>
        <separator/>
        <filter string="نقدي"         name="cash"         domain="[('financial_class','=','cash')]"/>
        <filter string="تأمين صحى"    name="insurance"    domain="[('financial_class','=','insurance')]"/>
        <filter string="نفقة الدولة"  name="state_class"  domain="[('financial_class','=','state')]"/>
        <filter string="تكافل وكرامة" name="takaful"      domain="[('financial_class','=','takaful')]"/>
        <filter string="تعاقدات"      name="contract"     domain="[('financial_class','=','contract')]"/>
        <filter string="مشورة"        name="consultation" domain="[('financial_class','=','consultation')]"/>
        <filter string="وزارة الصحة"  name="moh"          domain="[('financial_class','=','moh')]"/>
        <filter string="عاملين"       name="staff"        domain="[('financial_class','=','staff')]"/>
        <separator/>
        <filter string="مكتملة"  name="done"      domain="[('state','=','done')]"/>
        <filter string="ملغاة"   name="cancelled" domain="[('state','=','cancelled')]"/>
        <separator/>
        <filter string="تجميع: الوجهة المالية" name="group_financial" context="{'group_by': 'financial_class'}"/>
        <filter string="تجميع: العيادة"         name="group_specialty" context="{'group_by': 'specialty_id'}"/>
        <filter string="تجميع: الطبيب"          name="group_doctor"    context="{'group_by': 'doctor_id'}"/>
        <filter string="تجميع: التاريخ"         name="group_date"      context="{'group_by': 'admission_date:day'}"/>
      </search>
    </field>
  </record>

  <record id="action_saycare_visit_journal" model="ir.actions.act_window">
    <field name="name">سجل الزيارات</field>
    <field name="res_model">saycare.visit</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">لا توجد زيارات مسجلة</p>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════
       Top-level menu  →  SayCare HIS
  ═══════════════════════════════════════════════════════════════════ -->

  <menuitem id="menu_saycare_root"
            name="SayCare HIS"
            sequence="50"/>

  <menuitem id="menu_saycare_visit_journal"
            name="سجل الزيارات"
            parent="menu_saycare_root"
            action="action_saycare_visit_journal"
            sequence="10"/>

  <menuitem id="menu_saycare_config"
            name="الإعدادات"
            parent="menu_saycare_root"
            sequence="90"/>

  <menuitem id="menu_saycare_specialty"
            name="العيادات"
            parent="menu_saycare_config"
            action="action_saycare_specialty"
            sequence="10"/>

  <menuitem id="menu_saycare_service"
            name="الخدمات الطبية"
            parent="menu_saycare_config"
            action="action_saycare_service"
            sequence="20"/>

</odoo>
