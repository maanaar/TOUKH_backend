<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_room_list" model="ir.ui.view">
        <field name="name">hospital.room.list</field>
        <field name="model">hospital.room</field>
        <field name="arch" type="xml">
            <list string="الغرف" decoration-muted="room_status == 'closed'"
                  decoration-warning="room_status == 'maintenance'">
                <field name="code"/>
                <field name="room_no"/>
                <field name="department_id" readonly="0"/>
                <field name="floor_id"/>
                <field name="room_type"/>
                <field name="allowed_gender"/>
                <field name="capacity"/>
                <field name="bed_count"/>
                <field name="room_status"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_room_form" model="ir.ui.view">
        <field name="name">hospital.room.form</field>
        <field name="model">hospital.room</field>
        <field name="arch" type="xml">
            <form string="الغرفة">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="room_no"/>
                            <field name="floor_id"/>
                           <field name="department_id" readonly="0" />
                        </group>
                        <group>
                            <field name="room_type"/>
                            <field name="allowed_gender"/>
                            <field name="capacity"/>
                            <field name="room_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_room" model="ir.actions.act_window">
        <field name="name">الغرف</field>
        <field name="res_model">hospital.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>