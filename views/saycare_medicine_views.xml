<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════════════════════
       product.template — medicine tabs
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="product_template_form_medicine_tabs" model="ir.ui.view">
    <field name="name">product.template.form.medicine.tabs</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">

      <!-- ── Tab: التصنيف ── -->
      <notebook position="inside">
        <page string="Basket" name="basket_table">
          <group>
            <field name="basket_service_id"/>
            <button name="get_service_basket" type="object" string="Get Details" class="oe_highlight"/>
          </group>
          <group>
            <field name="basket_table_id" string="">
                <list editable="bottom">
                    <field name="serial_no"/>
                    <field name="product_product_id"/>
                    <field name="uom_id"/>
                    <field name="barcode"/>
                    <field name="planned_qty"/>
                    <field name="price"/>
                    <field name="total_price" readonly="1"/>
                </list>
            </field>
          </group>
        </page>

        <!-- ── Tab: بيانات الدواء ── -->
        <page string="بيانات الدواء" name="sc_drug_data">
          <group string="متشابهات الدواء" name="drug_similarities">
            <div class="d-flex align-items-center gap-3">
              <label for="is_look_alike"/>
              <field name="is_look_alike" widget="boolean_toggle"/>
              <label for="is_sound_alike" class="ms-4"/>
              <field name="is_sound_alike" widget="boolean_toggle"/>
              <label for="is_high_concentration" class="ms-4"/>
              <field name="is_high_concentration" widget="boolean_toggle"/>
              <label for="is_hazardous" class="ms-4"/>
              <field name="is_hazardous" widget="boolean_toggle"/>
            </div>
          </group>

          <group string="المعلومات الدوائية" name="drug_info">
            <group>
              <field name="generic_name"/>
              <field name="dosage_form"/>
              <field name="medicine_concentration"/>
              <field name="primary_route"/>
              <field name="secondary_route"/>
            </group>
            <group>
              <field name="atc_code"/>
              <field name="dispensing_category"/>
              <field name="usual_dose"/>
              <field name="max_daily_dose"/>
            </group>
          </group>

          <group string="الاستخدام في الحمل والرضاعة" name="pregnancy_lactation_group" col="6">
            <field name="pregnancy_category"/>
            <field name="lactation_use"/>
            <field name="pediatric_use"/>
          </group>

          <group string="التحذيرات والتفاعلات" name="warnings_interactions">
            <group>
              <field name="contraindications" placeholder="مثال: فرط الحساسية للمادة الفعالة..."/>
              <field name="side_effects" placeholder="مثال: غثيان، طفح جلدي نادر..."/>
            </group>
            <group>
              <field name="special_warnings" placeholder="مثال: الحذر في قصور الكلى..."/>
              <field name="drug_interactions" placeholder="مثال: يزيد من تأثير مضادات التختر..."/>
            </group>
          </group>

          <group string="التصنيف والأسعار والتخزين" name="sc_classification_prices_storage">
            <group string="التصنيف" name="sc_classification_sub">
              <field name="group_id" string="المجموعة"/>
              <field name="usage_type_ids" widget="many2many_tags" string="نوع الاستخدام"/>
            </group>
            <group string="الأسعار الجبرية" name="sc_prices_sub">
              <field name="forced_price_currency_id" invisible="1"/>
              <field name="forced_price"
                     widget="monetary"
                     options="{'currency_field': 'forced_price_currency_id'}"
                     string="السعر الجبرى"/>
            </group>
            <group string="المخزون والتخزين" name="sc_storage_sub">
              <field name="needs_refrigeration" string="يحتاج الى تبريد"/>
              <field name="storage_temp"
                     invisible="not needs_refrigeration"
                     string="درجة الحرارة (°C)"/>
            </group>
          </group>
          <div class="alert alert-info o_form_label_factor" role="alert"
               invisible="not needs_refrigeration">
            <i class="fa fa-snowflake-o me-1"/>
            ملاحظة: يجب أن تكون درجة الحرارة من <strong>2</strong> إلى <strong>8</strong> درجة مئوية
          </div>
        </page>

      </notebook>
    </field>
  </record>


  <!-- ═══════════════════════════════════════════════════════════════
       product.template — uom_small after uom_id
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="product_template_form_medicine_uom_small" model="ir.ui.view">
    <field name="name">product.template.form.medicine.uom.small</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <field name="uom_id" position="after">
        <field name="uom_small" string="الوحدة الصغرى"/>
      </field>
    </field>
  </record>


  <!-- ═══════════════════════════════════════════════════════════════
       product.category — is_medicines + smart button
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="product_category_form_medicine" model="ir.ui.view">
    <field name="name">product.category.form.medicine</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_form_view"/>
    <field name="arch" type="xml">

      <!-- Smart button box -->
      <xpath expr="//form/sheet" position="before">
        <div class="oe_button_box" name="button_box">
          <button name="action_view_pharmacy_products" type="object"
                  class="oe_stat_button" icon="fa-pills"
                  invisible="not is_medicines">
            <field name="medicine_product_count" widget="statinfo" string="الأصناف"/>
          </button>
        </div>
      </xpath>

      <!-- is_medicines checkbox inside the form -->
      <xpath expr="//form/sheet" position="inside">
        <group string="الصيدلية">
          <field name="is_medicines" string="أدوية (صيدلية)"/>
        </group>
      </xpath>

    </field>
  </record>


  <!-- ═══════════════════════════════════════════════════════════════
       stock.picking — Q Sant column
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="stock_picking_form_q_sant" model="ir.ui.view">
    <field name="name">stock.picking.form.q.sant</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="after">
        <field name="q_sant" string="Q Sant" optional="show"/>
      </xpath>
    </field>
  </record>


  <!-- ═══════════════════════════════════════════════════════════════
       saycare.usage.type — list + form
  ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_saycare_usage_type_list" model="ir.ui.view">
    <field name="name">saycare.usage.type.list</field>
    <field name="model">saycare.usage.type</field>
    <field name="arch" type="xml">
      <list string="أنواع الاستخدام" editable="bottom">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="action_saycare_usage_type" model="ir.actions.act_window">
    <field name="name">أنواع الاستخدام</field>
    <field name="res_model">saycare.usage.type</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">أضف نوع استخدام جديداً</p>
    </field>
  </record>

  <menuitem id="menu_saycare_usage_type"
            name="أنواع الاستخدام"
            parent="menu_saycare_config"
            action="action_saycare_usage_type"
            sequence="30"/>

</odoo>
