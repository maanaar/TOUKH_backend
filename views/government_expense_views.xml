<odoo>
    <record id="view_government_expense_list" model="ir.ui.view">
        <field name="name">saycare.government.expense.decision.list</field>
        <field name="model">saycare.government.expense.decision</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number"/>
                <field name="status"/>
                <field name="patient_id"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <record id="view_government_expense_form" model="ir.ui.view">
        <field name="name">saycare.government.expense.decision.form</field>
        <field name="model">saycare.government.expense.decision</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- ── Header info ─────────────────────────────────── -->
                    <group>
                        <group string="بيانات القرار">
                            <field name="name"/>
                            <field name="number"/>
                            <field name="status"/>
                            <field name="patient_id"/>
                            <field name="total_amount" string="إجمالي المبلغ (ج.م)"/>
                            <field name="start_date"/>
                            <field name="month_count"/>
                            <field name="notes"/>
                        </group>
                        <group string="الخدمات المسموح بها">
                            <field name="specialty_ids"       widget="many2many_tags" string="العيادات"/>
                            <field name="medicine_categ_ids"  widget="many2many_tags" string="مجموعات الأدوية"
                                   domain="[('parent_id.name', 'ilike', 'medications')]"/>
                            <field name="test_ids"   widget="many2many_tags" string="التحاليل"
                                   domain="[('categ_id.name', 'ilike', 'معمل')]"/>
                            <field name="scans_ids"  widget="many2many_tags" string="الأشعة"
                                   domain="['|', ('categ_id.name', 'ilike', 'أشعة'), ('categ_id.name', 'ilike', 'اشعة')]"/>
                        </group>
                    </group>

                    <!-- ── Financial summary ───────────────────────────── -->
                    <group string="ملخص مالي" col="6">
                        <field name="total_amount"        string="قيمة القرار"      readonly="1"/>
                        <field name="deduction_amount"    string="خصم المؤسسة"/>
                        <field name="distributable_amount" string="الصافي للتوزيع"  readonly="1"/>
                        <field name="allocated_total"     string="الموزع"           readonly="1"/>
                        <field name="usable_remaining"    string="المتاح"           readonly="1"/>
                        <field name="expired_amount"      string="منتهي"            readonly="1"/>
                    </group>

                    <notebook>
                        <!-- ── Monthly allocations ────────────────────── -->
                        <page string="التوزيع الشهري">
                            <field name="allocation_ids" readonly="1">
                                <list decoration-success="state_label == 'جاري'"
                                      decoration-muted="state_label == 'منتهي'"
                                      decoration-info="state_label == 'قادم'">
                                    <field name="label"       string="الشهر"/>
                                    <field name="amount"      string="الحد الشهري"/>
                                    <field name="addition"    string="الإضافة"/>
                                    <field name="used_amount" string="المستخدم"/>
                                    <field name="remaining"   string="المتبقي"/>
                                    <field name="state_label" string="الحالة"/>
                                    <field name="manual"      string="يدوي"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Transactions ───────────────────────────── -->
                        <page string="المعاملات">
                            <field name="transaction_ids" readonly="1">
                                <list>
                                    <field name="reference_no"         string="رقم المرجع"/>
                                    <field name="date"                  string="التاريخ"/>
                                    <field name="specialty_name"        string="العيادة"/>
                                    <field name="item_type"             string="النوع"/>
                                    <field name="item_name"             string="الخدمة / الدواء"/>
                                    <field name="category"              string="الفئة"/>
                                    <field name="qty"                   string="الكمية"/>
                                    <field name="amount"                string="القيمة"/>
                                    <field name="deducted"              string="المخصوم فعلياً"/>
                                    <field name="touches_future_month"  string="خصم من شهر لاحق"/>
                                    <field name="notes"                 string="ملاحظة"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_government_expense" model="ir.actions.act_window">
        <field name="name">قرارات</field>
        <field name="res_model">saycare.government.expense.decision</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Settings singleton form -->
    <record id="view_government_expense_settings_form" model="ir.ui.view">
        <field name="name">saycare.government.expense.settings.form</field>
        <field name="model">saycare.government.expense.settings</field>
        <field name="arch" type="xml">
            <form string="إعدادات قرارات نفقة الدولة">
                <sheet>
                    <div class="oe_title">
                        <h1>إعدادات قرارات نفقة الدولة</h1>
                    </div>
                    <group string="إعدادات المبالغ">
                        <group>
                            <field name="deduction_amount"
                                   string="المبلغ المخصوم (ج.م)"
                                   help="يُخصم من إجمالي القرار قبل توزيع الباقي على الشهور"/>
                        </group>
                        <group>
                            <field name="max_addition_amount"
                                   string="أقصى مبلغ إضافة للشهر (ج.م)"
                                   help="أقصى مبلغ يمكن إضافته على قيمة شهر واحد"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The old action_government_expense_settings (ir.actions.act_window) used
         to open a blank/new record every time (defaulting deduction_amount to
         60). It's no longer defined here or referenced by any menu - the row
         stays in the DB unused, harmlessly. The menu now points at this server
         action instead, which always loads the single persisted settings
         record via action_open_settings(). -->
    <record id="action_government_expense_settings_open" model="ir.actions.server">
        <field name="name">إعدادات القرارات</field>
        <field name="model_id" ref="model_saycare_government_expense_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_settings()</field>
    </record>
</odoo>
