<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_grade_list" model="ir.ui.view">
        <field name="name">hospital.accommodation.grade.list</field>
        <field name="model">hospital.accommodation.grade</field>
        <field name="arch" type="xml">
            <list string="درجات الإقامة">
                <field name="code"/>
                <field name="name"/>
                <field name="accommodation_type"/>
                <field name="price_per_day"/>
<!--                <field name="price_per_day"/>-->
<!--                <field name="currency_id" column_invisible="1"/>-->
                <field name="include_nursing"/>
                <field name="include_meals"/>
                <field name="need_approval"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_grade_form" model="ir.ui.view">
        <field name="name">hospital.accommodation.grade.form</field>
        <field name="model">hospital.accommodation.grade</field>
        <field name="arch" type="xml">
            <form string="درجة الإقامة">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="accommodation_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                             <field name="price_per_day"/>
<!--                            <field name="currency_id" invisible="1"/>-->
<!--                            <field name="price_per_day"/>-->
                            <field name="include_nursing"/>
                            <field name="include_meals"/>
                            <field name="need_approval"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_grade" model="ir.actions.act_window">
        <field name="name">درجات الإقامة</field>
        <field name="res_model">hospital.accommodation.grade</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>