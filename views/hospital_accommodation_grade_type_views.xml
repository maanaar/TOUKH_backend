<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_grade_type_list" model="ir.ui.view">
        <field name="name">hospital.accommodation.grade.type.list</field>
        <field name="model">hospital.accommodation.grade.type</field>
        <field name="arch" type="xml">
            <list string="أسماء درجات الإقامة">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_grade_type_form" model="ir.ui.view">
        <field name="name">hospital.accommodation.grade.type.form</field>
        <field name="model">hospital.accommodation.grade.type</field>
        <field name="arch" type="xml">
            <form string="اسم درجة الإقامة">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_grade_type" model="ir.actions.act_window">
        <field name="name">أسماء درجات الإقامة</field>
        <field name="res_model">hospital.accommodation.grade.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
