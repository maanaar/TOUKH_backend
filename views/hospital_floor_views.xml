<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_floor_list" model="ir.ui.view">
        <field name="name">hospital.floor.list</field>
        <field name="model">hospital.floor</field>
        <field name="arch" type="xml">
            <list string="الأدوار">
                <field name="code"/>
                <field name="name"/>
                <field name="building"/>
                <field name="floor_no"/>
                <field name="department_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_floor_form" model="ir.ui.view">
        <field name="name">hospital.floor.form</field>
        <field name="model">hospital.floor</field>
        <field name="arch" type="xml">
            <form string="الدور">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="building"/>
                            <field name="floor_no"/>
                            <field name="department_id"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_floor" model="ir.actions.act_window">
        <field name="name">الأدوار</field>
        <field name="res_model">hospital.floor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>