<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_saycare_visit" model="ir.sequence">
            <field name="name">Patient Visit</field>
            <field name="code">saycare.visit</field>
            <field name="prefix">VIS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_visit_emergency" model="ir.sequence">
            <field name="name">Emergency Visit</field>
            <field name="code">saycare.visit.emergency</field>
            <field name="prefix">ER-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_visit_emergency_unknown" model="ir.sequence">
            <field name="name">Emergency Visit - Unknown Patient</field>
            <field name="code">saycare.visit.emergency.unknown</field>
            <field name="prefix">UNKN-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_appointment" model="ir.sequence">
            <field name="name">Appointment</field>
            <field name="code">saycare.appointment</field>
            <field name="prefix">APT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_patient_mrn" model="ir.sequence">
            <field name="name">Patient MRN</field>
            <field name="code">saycare.patient.mrn</field>
            <field name="prefix">MRN</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_patient_mrn_unknown" model="ir.sequence">
            <field name="name">Unknown Patient MRN</field>
            <field name="code">saycare.patient.mrn.unknown</field>
            <field name="prefix">UNKN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_admission_request_inpatient" model="ir.sequence">
            <field name="name">Admission Request - Inpatient Booking</field>
            <field name="code">saycare.admission.request.inpatient</field>
            <field name="prefix">ADM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_admission_request_operation" model="ir.sequence">
            <field name="name">Admission Request - Operation Booking</field>
            <field name="code">saycare.admission.request.operation</field>
            <field name="prefix">OPB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_saycare_inventory_count_request" model="ir.sequence">
            <field name="name">Inventory Count Request</field>
            <field name="code">saycare.inventory.count.request</field>
            <field name="prefix">INV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Overrides the purchase module's own sequence (P00001) so purchase
             orders read as RFQ0001, matching the اوامر الشراء page. -->
        <record id="purchase.seq_purchase_order" model="ir.sequence">
            <field name="prefix">RFQ</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
