<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_saycare_department_stock_request" model="ir.sequence">
        <field name="name">Department Stock Request</field>
        <field name="code">saycare.department.stock.request</field>
        <field name="prefix">DSR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_saycare_department_stock_issue" model="ir.sequence">
        <field name="name">Department Stock Issue</field>
        <field name="code">saycare.department.stock.issue</field>
        <field name="prefix">DSI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
